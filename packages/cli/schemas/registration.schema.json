{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "repository": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "fullName": {
          "type": "string",
          "pattern": "^[\\w-]+\\/[\\w.-]+$"
        }
      },
      "required": [
        "id",
        "fullName"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "commitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "prNumber": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "projectPath": {
          "anyOf": [
            {
              "type": "string",
              "const": "."
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "policyRef": {
          "type": "string",
          "minLength": 1
        },
        "configRef": {
          "type": "string",
          "minLength": 1
        },
        "fileHashes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "required": [
        "commitSha",
        "prNumber",
        "projectPath",
        "policyRef",
        "fileHashes"
      ],
      "additionalProperties": false
    },
    "policyId": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "profileVersion": {
          "type": "string",
          "const": "1"
        },
        "rules": {}
      },
      "required": [
        "schemaVersion",
        "profileVersion",
        "rules"
      ],
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "mode": {
          "default": "audit",
          "type": "string",
          "enum": [
            "audit",
            "gate"
          ]
        },
        "profile": {
          "default": "standard",
          "type": "string",
          "enum": [
            "basic",
            "standard",
            "critical"
          ]
        },
        "profileVersion": {
          "default": "1",
          "type": "string",
          "const": "1"
        },
        "riskOverrides": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "selector": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "path"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "module"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "contract-kind"
                      },
                      "value": {
                        "type": "string",
                        "enum": [
                          "examples",
                          "invariant",
                          "state_machine",
                          "api_contract",
                          "external"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "profile": {
                "type": "string",
                "enum": [
                  "basic",
                  "standard",
                  "critical"
                ]
              }
            },
            "required": [
              "selector",
              "profile"
            ],
            "additionalProperties": false
          }
        },
        "git": {
          "default": {
            "base": "origin/main"
          },
          "type": "object",
          "properties": {
            "base": {
              "default": "origin/main",
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "reports": {
          "default": {},
          "type": "object",
          "properties": {
            "vitest": {
              "type": "string",
              "minLength": 1
            },
            "coverage": {
              "type": "string",
              "minLength": 1
            },
            "mutation": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "executionManifests": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rules": {
          "default": {}
        },
        "contracts": {
          "default": {
            "enabled": false,
            "sources": [],
            "requireExecutionEvidence": true,
            "approval": {
              "provider": "github-protected-review",
              "requiredForRisk": [
                "critical"
              ],
              "onUnverifiable": "unknown"
            },
            "documents": {
              "output": ".behavproof/generated",
              "commit": false
            }
          },
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "sources": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "vitest-inline",
                      "manifest",
                      "external",
                      "gherkin",
                      "openapi"
                    ]
                  },
                  "include": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "type",
                  "include"
                ],
                "additionalProperties": false
              }
            },
            "requireExecutionEvidence": {
              "default": true,
              "type": "boolean"
            },
            "approval": {
              "default": {
                "provider": "github-protected-review",
                "requiredForRisk": [
                  "critical"
                ],
                "onUnverifiable": "unknown"
              },
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "github-protected-review"
                },
                "requiredForRisk": {
                  "default": [
                    "critical"
                  ],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "basic",
                      "standard",
                      "critical"
                    ]
                  }
                },
                "onUnverifiable": {
                  "default": "unknown",
                  "type": "string",
                  "const": "unknown"
                }
              },
              "required": [
                "provider"
              ],
              "additionalProperties": false
            },
            "documents": {
              "default": {
                "output": ".behavproof/generated",
                "commit": false
              },
              "type": "object",
              "properties": {
                "output": {
                  "default": ".behavproof/generated",
                  "type": "string",
                  "minLength": 1
                },
                "commit": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion"
      ],
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "repositoryId": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "type": "string",
          "minLength": 1
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "examples",
                  "invariant",
                  "state_machine",
                  "api_contract",
                  "external"
                ]
              },
              "intentIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "revisionHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "sourceRef": {
                "type": "string",
                "minLength": 1
              },
              "caseIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "risk": {
                "type": "string",
                "enum": [
                  "basic",
                  "standard",
                  "critical"
                ]
              },
              "cases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "input": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "expected": {
                      "$ref": "#/$defs/__schema1"
                    },
                    "negative": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "input",
                    "expected"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "kind",
              "intentIds",
              "revisionHash",
              "sourceRef"
            ],
            "additionalProperties": false
          }
        },
        "intents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "risk": {
                "type": "string",
                "enum": [
                  "basic",
                  "standard",
                  "critical"
                ]
              },
              "contentHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "origin": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "inline",
                      "manifest",
                      "external"
                    ]
                  },
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "ref"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "statement",
              "risk",
              "contentHash",
              "origin"
            ],
            "additionalProperties": false
          }
        },
        "policyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "extractorVersion": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "discoveryDiagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "sourceRef": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "sourceRef",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "commitSha",
        "contracts",
        "intents"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "configPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claimScopes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contractId": {
            "type": "string",
            "minLength": 1
          },
          "caseIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "targetRef": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "contractId",
          "caseIds",
          "targetRef",
          "method"
        ],
        "additionalProperties": false
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "const": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "intent",
                  "contract",
                  "policy",
                  "registry"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "contentHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "kind",
              "id",
              "contentHash"
            ],
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown",
              "not_applicable"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "provider",
              "ref"
            ],
            "additionalProperties": false
          },
          "approvedBy": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "subjectCommitSha": {
            "type": "string",
            "minLength": 1
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "schemaVersion",
          "id",
          "target",
          "status",
          "source",
          "approvedBy",
          "reasons"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "repository",
    "source",
    "policyId",
    "policy",
    "config",
    "baseline",
    "inputs",
    "configPaths",
    "claimScopes",
    "approvals"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  }
}
