{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1
    },
    "commitSha": {
      "type": "string",
      "minLength": 1
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "formal": {
            "type": "object",
            "properties": {
              "modelId": {
                "type": "string",
                "minLength": 1
              },
              "modelHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "driverHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "propertyIds": {
                "minItems": 1,
                "maxItems": 10000,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "modelId",
              "modelHash",
              "propertyIds"
            ],
            "additionalProperties": false
          },
          "kind": {
            "type": "string",
            "enum": [
              "examples",
              "invariant",
              "state_machine",
              "api_contract",
              "external"
            ]
          },
          "intentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "revisionHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1
          },
          "caseIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "risk": {
            "type": "string",
            "enum": [
              "basic",
              "standard",
              "critical"
            ]
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {
                  "$ref": "#/$defs/__schema0"
                },
                "expected": {
                  "$ref": "#/$defs/__schema1"
                },
                "negative": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "input",
                "expected"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "kind",
          "intentIds",
          "revisionHash",
          "sourceRef"
        ],
        "additionalProperties": false
      }
    },
    "intents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "type": "string",
            "enum": [
              "basic",
              "standard",
              "critical"
            ]
          },
          "contentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "origin": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "inline",
                  "manifest",
                  "external"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "ref"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "statement",
          "risk",
          "contentHash",
          "origin"
        ],
        "additionalProperties": false
      }
    },
    "policyHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "extractorVersion": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "discoveryDiagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "sourceRef",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "commitSha",
    "contracts",
    "intents"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  }
}
