{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "maxItems": 100,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "revisionHash": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "required": [
      "id",
      "revisionHash"
    ],
    "additionalProperties": false
  }
}
