{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "assurance": {
      "type": "object",
      "properties": {
        "driver": {
          "type": "string",
          "minLength": 1
        },
        "driverSources": {
          "minItems": 1,
          "maxItems": 10000,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "implementationSources": {
          "minItems": 1,
          "maxItems": 10000,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "report": {
          "type": "string",
          "minLength": 1
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        }
      },
      "required": [
        "driver",
        "driverSources",
        "implementationSources",
        "report"
      ],
      "additionalProperties": false
    },
    "formal": {
      "type": "object",
      "properties": {
        "models": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "contractId": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "modelSources": {
                "default": [],
                "maxItems": 10000,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "quint": {
                "type": "object",
                "properties": {
                  "entry": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "apalacheVersion": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "entry",
                  "version"
                ],
                "additionalProperties": false
              },
              "properties": {
                "maxItems": 10000,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "checks": {
                "minItems": 1,
                "maxItems": 10000,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "parse",
                    "typecheck",
                    "test",
                    "run",
                    "verify"
                  ]
                }
              },
              "maxSteps": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "maxSamples": {
                "default": 100,
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "seed": {
                "type": "string",
                "minLength": 1
              },
              "timeoutMs": {
                "default": 60000,
                "type": "integer",
                "minimum": 1,
                "maximum": 3600000
              },
              "report": {
                "type": "string",
                "minLength": 1
              },
              "driver": {
                "type": "string",
                "minLength": 1
              },
              "driverSources": {
                "maxItems": 10000,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "implementation": {
                "type": "string",
                "minLength": 1
              },
              "implementationSources": {
                "default": [],
                "maxItems": 10000,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "conformanceReport": {
                "type": "string",
                "minLength": 1
              },
              "traceReceipt": {
                "type": "string",
                "minLength": 1
              },
              "traceDirectory": {
                "type": "string",
                "minLength": 1
              },
              "requiredActions": {
                "default": [],
                "maxItems": 10000,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "minTraces": {
                "default": 1,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "minComparisons": {
                "default": 1,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "requireCanary": {
                "default": true,
                "type": "boolean"
              },
              "canary": {
                "type": "object",
                "properties": {
                  "faultId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "implementation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "targetRef": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "faultId",
                  "implementation",
                  "targetRef"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "contractId",
              "model",
              "quint",
              "properties",
              "checks",
              "maxSteps",
              "seed",
              "report"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "models"
      ],
      "additionalProperties": false
    },
    "mode": {
      "default": "audit",
      "type": "string",
      "enum": [
        "audit",
        "gate"
      ]
    },
    "profile": {
      "default": "standard",
      "type": "string",
      "enum": [
        "basic",
        "standard",
        "critical"
      ]
    },
    "profileVersion": {
      "default": "1",
      "type": "string",
      "const": "1"
    },
    "riskOverrides": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "selector": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "path"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "module"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "contract-kind"
                  },
                  "value": {
                    "type": "string",
                    "enum": [
                      "examples",
                      "invariant",
                      "state_machine",
                      "api_contract",
                      "external"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              }
            ]
          },
          "profile": {
            "type": "string",
            "enum": [
              "basic",
              "standard",
              "critical"
            ]
          }
        },
        "required": [
          "selector",
          "profile"
        ],
        "additionalProperties": false
      }
    },
    "git": {
      "default": {
        "base": "origin/main"
      },
      "type": "object",
      "properties": {
        "base": {
          "default": "origin/main",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "reports": {
      "default": {},
      "type": "object",
      "properties": {
        "vitest": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "mutation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "executionManifests": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rules": {
      "default": {}
    },
    "contracts": {
      "default": {
        "enabled": false,
        "sources": [],
        "requireExecutionEvidence": true,
        "approval": {
          "provider": "github-protected-review",
          "requiredForRisk": [
            "critical"
          ],
          "onUnverifiable": "unknown"
        },
        "documents": {
          "output": ".behavproof/generated",
          "commit": false
        }
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "sources": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "vitest-inline",
                  "manifest",
                  "external",
                  "gherkin",
                  "openapi"
                ]
              },
              "include": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "type",
              "include"
            ],
            "additionalProperties": false
          }
        },
        "requireExecutionEvidence": {
          "default": true,
          "type": "boolean"
        },
        "approval": {
          "default": {
            "provider": "github-protected-review",
            "requiredForRisk": [
              "critical"
            ],
            "onUnverifiable": "unknown"
          },
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "github-protected-review"
            },
            "requiredForRisk": {
              "default": [
                "critical"
              ],
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "basic",
                  "standard",
                  "critical"
                ]
              }
            },
            "onUnverifiable": {
              "default": "unknown",
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "provider"
          ],
          "additionalProperties": false
        },
        "documents": {
          "default": {
            "output": ".behavproof/generated",
            "commit": false
          },
          "type": "object",
          "properties": {
            "output": {
              "default": ".behavproof/generated",
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "default": false,
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion"
  ],
  "additionalProperties": false
}
