{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "properties": {
        "repositoryId": {
          "type": "string",
          "minLength": 1
        },
        "prHeadSha": {
          "type": "string",
          "minLength": 1
        },
        "testedCommitSha": {
          "type": "string",
          "minLength": 1
        },
        "testedCommitParents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceTreeHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "baseSha": {
          "type": "string",
          "minLength": 1
        },
        "diffBaseSha": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "testedCommitSha",
        "sourceTreeHash",
        "dirty"
      ],
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "collectorVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tool",
        "version",
        "collectorVersion"
      ],
      "additionalProperties": false
    },
    "commandHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configHashes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "dependencyLockHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environment": {
      "type": "object",
      "properties": {
        "nodeVersion": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "nodeVersion",
        "platform"
      ],
      "additionalProperties": false
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "exitCode": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "ref",
          "sha256",
          "kind",
          "scope"
        ],
        "additionalProperties": false
      }
    },
    "ci": {
      "type": "object",
      "properties": {
        "repositoryId": {
          "type": "string",
          "minLength": 1
        },
        "workflowRef": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "runAttempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "eventName": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repositoryId",
        "workflowRef",
        "runId",
        "runAttempt",
        "jobId",
        "eventName"
      ],
      "additionalProperties": false
    },
    "attestationRef": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "executionId",
    "subject",
    "producer",
    "commandHash",
    "configHashes",
    "environment",
    "startedAt",
    "completedAt",
    "exitCode",
    "artifacts"
  ],
  "additionalProperties": false
}
