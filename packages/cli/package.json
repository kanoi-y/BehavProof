{
  "name": "@behavproof/cli",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "files": [
    "dist",
    "schemas",
    "presets",
    "templates"
  ],
  "bin": {
    "behavproof": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    }
  },
  "dependencies": {
    "@behavproof/core": "0.2.0",
    "@behavproof/adapter-reports": "0.2.0",
    "@behavproof/spec-registry": "0.2.0",
    "@behavproof/adapter-github": "0.2.0",
    "zod": "4.6.7",
    "typescript-parser": "npm:typescript@5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanoi-y/BehavProof.git",
    "directory": "packages/cli"
  },
  "peerDependencies": {
    "@behavproof/adapter-quint": "0.2.0",
    "@behavproof/adapter-model-test": "0.2.0"
  },
  "peerDependenciesMeta": {
    "@behavproof/adapter-quint": {
      "optional": true
    },
    "@behavproof/adapter-model-test": {
      "optional": true
    }
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "BehavProof cli: authenticated behavioral evidence for protected development workflows"
}
