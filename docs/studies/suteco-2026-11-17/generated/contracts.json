        "method": "example",
        "targetRef": "validation/target.mjs#observe",
        "cases": [
          {
            "id": "dataset-cross-municipality",
            "input": {
              "id": "dataset-cross-municipality"
            },
            "expected": {
              "schemaAccepted": false,
              "importRejected": true,
              "foreignRule": {
                "municipalityId": "city-b",
                "itemId": "city-b-item",
                "categoryName": "city-b category",
                "instructions": "city-b instructions"
              }
            }
          }
        ]
      },
      {
        "id": "dataset-valid",
        "method": "example",
        "targetRef": "validation/target.mjs#observe",
        "cases": [
          {
            "id": "dataset-valid",
            "input": {
              "id": "dataset-valid"
            },
            "expected": {
              "schemaAccepted": true,
              "importRejected": false,
              "counts": {
                "municipalities": 1,
                "items": 1,
                "rules": 1
              },
              "storedItemId": "valid-city-item"
            }
          }
        ]
      },
      {
        "id": "dataset-dangling-item",
        "method": "example",
        "targetRef": "validation/target.mjs#observe",
        "cases": [
          {
            "id": "dataset-dangling-item",
            "input": {
              "id": "dataset-dangling-item"
            },
            "expected": {
              "schemaAccepted": false,
              "importRejected": true,
              "unchanged": true
            }
          }
        ]
      },
      {
        "id": "startup-version-only",
        "method": "example",
        "targetRef": "validation/target.mjs#observe",
        "cases": [
          {
            "id": "startup-version-only",
            "input": {
              "id": "startup-version-only"
            },
            "expected": {
              "database": "2025-09-01",
              "store": "2025-09-01",
              "persistence": "2025-09-01",
              "display": "2025-09-01"
            }
          }
        ]
      },
      {
        "id": "startup-content-change-control",
        "method": "example",
        "targetRef": "validation/target.mjs#observe",
        "cases": [
          {
            "id": "startup-content-change-control",
            "input": {
              "id": "startup-content-change-control"
            },
            "expected": {
              "database": "2025-09-01",
              "store": "2025-09-01",
              "persistence": "2025-09-01",
              "display": "2025-09-01"
            }
          }
        ]
      },
      {
        "id": "unsafe-official-link",
        "method": "example",
        "targetRef": "validation/target.mjs#observe",
        "cases": [
          {
            "id": "unsafe-official-link",
            "input": {
              "id": "unsafe-official-link"
            },
            "expected": {
              "openedUris": []
            }
          }
        ]
      },
      {
        "id": "safe-official-link",
        "method": "example",
        "targetRef": "validation/target.mjs#observe",
        "cases": [
          {
            "id": "safe-official-link",
            "input": {
              "id": "safe-official-link"
            },
            "expected": {
              "schemaAccepted": true,
              "importAccepted": true,
              "renderedOfficialUrl": true,
              "openedUris": [
                "https://example.invalid/suteco-study-only"
              ]
            }
          }
        ]
      },
      {
        "id": "municipality-event-turn-control",
        "method": "example",
        "targetRef": "validation/target.mjs#observe",
        "cases": [
          {
            "id": "municipality-event-turn-control",
            "input": {
