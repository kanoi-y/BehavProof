    "conditions": [
      {
        "id": "dataset-cross-municipality",
        "kind": "postcondition",
        "statement": "A municipality dataset rejects foreign rules and preserves the foreign municipality rule.",
        "checks": [
          "dataset-cross-municipality"
        ],
        "requiredFaults": []
      },
      {
        "id": "dataset-valid",
        "kind": "postcondition",
        "statement": "A valid dataset imports the declared municipality, item and rule.",
        "checks": [
          "dataset-valid"
        ],
        "requiredFaults": []
      },
      {
        "id": "dataset-dangling-item",
        "kind": "postcondition",
        "statement": "An unknown item reference is rejected without changing existing state.",
        "checks": [
          "dataset-dangling-item"
        ],
        "requiredFaults": []
      },
      {
        "id": "startup-version-only",
        "kind": "postcondition",
        "statement": "A version-only bundled update reaches the database, selected state, persistence and settings display.",
        "checks": [
          "startup-version-only"
        ],
        "requiredFaults": []
      },
      {
        "id": "startup-content-change-control",
        "kind": "postcondition",
        "statement": "Changed content and version refresh correctly through the original startup flow.",
        "checks": [
          "startup-content-change-control"
        ],
        "requiredFaults": []
      },
      {
        "id": "unsafe-official-link",
        "kind": "postcondition",
        "statement": "A local-file reference URI is not handed to the native link opener.",
        "checks": [
          "unsafe-official-link"
        ],
        "requiredFaults": []
      },
      {
        "id": "safe-official-link",
        "kind": "postcondition",
        "statement": "An HTTPS reference survives validation/storage and is handed to the recorded opener.",
        "checks": [
          "safe-official-link"
        ],
        "requiredFaults": []
      },
      {
        "id": "municipality-event-turn-control",
        "kind": "postcondition",
        "statement": "A later event-turn municipality selection remains selected after a synchronous SQLite load.",
        "checks": [
          "municipality-event-turn-control"
        ],
        "requiredFaults": []
      }
    ]
  }
