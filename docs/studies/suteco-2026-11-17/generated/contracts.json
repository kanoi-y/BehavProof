{
  "id": "SUTECO-STUDY",
  "intent": "Measure selected original-code municipality, startup and reference-link conditions.",
  "risk": "basic",
  "cases": [
    {
      "id": "study-inventory",
      "input": null,
      "expected": null
    }
  ],
  "assurance": {
