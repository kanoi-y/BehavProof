{
  "name": "behavproof-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core && node scripts/build-commonjs.mjs && tsc -b && node scripts/build-artifacts.mjs",
    "test": "npm run build && vitest run",
    "typecheck": "tsc -b packages/core && node scripts/build-commonjs.mjs && tsc -b",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "jest": "30.5.2",
    "jest29": "npm:jest@29.7.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanoi-y/BehavProof.git"
  }
}
