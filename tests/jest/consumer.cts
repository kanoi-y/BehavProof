import {defineContract,contractTest,type ContractDefinition} from '@behavproof/jest';
import {observeTargetCall,withTargetCalls,type TargetCall} from '@behavproof/jest/probe';
import Reporter from '@behavproof/jest/reporter';
import runner from '@behavproof/jest/runner';
const definition:ContractDefinition<number,number>={id:'types',intent:'types',risk:'basic',cases:[{id:'one',input:1,expected:2}]};
const contract=defineContract(definition);
contractTest.each(contract,({input})=>input+1);
observeTargetCall('target');
void withTargetCalls(()=>2,(calls:TargetCall[])=>calls.length);
new Reporter();
void runner;
