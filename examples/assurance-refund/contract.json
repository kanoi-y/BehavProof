{
  "id": "REFUND",
  "intent": "Reject unauthorized refunds and prevent duplicate or hidden state changes.",
  "risk": "basic",
  "cases": [
    {
      "id": "denied",
      "input": {
        "owner": false,
        "amount": 1,
        "balance": 100
      },
      "expected": false
    }
  ],
  "assurance": {
    "feature": {
      "id": "refund",
      "entrypoints": [
        "POST /refund"
      ]
    },
    "checks": [
      {
        "id": "authorization",
        "method": "example",
        "targetRef": "src/refund.mjs#canRefund",
        "cases": [
          {
            "id": "denied",
            "input": {
              "owner": false,
              "amount": 1,
              "balance": 100
            },
            "expected": false
          },
          {
            "id": "allowed",
            "input": {
              "owner": true,
              "amount": 1,
              "balance": 100
            },
            "expected": true
          }
        ]
      },
      {
        "id": "no-write",
        "method": "effects",
        "targetRef": "src/refund.mjs#refund",
        "cases": [
          {
            "id": "denied",
            "input": {
              "owner": false,
              "amount": 1,
              "balance": 100
            },
            "expected": {
              "status": "denied"
            }
          }
        ],
        "scope": [
          "store"
        ],
        "resources": [
          {
            "scope": "store",
            "adapter": "boundaries/store.mjs",
            "targets": [
              "refund-store"
            ]
          }
        ],
        "allowedChanges": [],
        "unchangedFields": [
          {
            "scope": "store",
            "field": "/balance"
          }
        ],
        "effects": [
          {
            "id": "write",
            "scope": "store",
            "min": 0,
            "max": 0
          }
        ],
        "window": {
          "durationMs": 5,
          "settledBy": "bounded observation window"
        }
      },
      {
        "id": "amount-property",
        "method": "property",
        "targetRef": "src/refund.mjs#canRefund",
        "domain": {
          "amount": [
            0,
            110
          ],
          "balance": 100,
          "owner": [
            false,
            true
          ]
        },
        "seed": "42",
        "runs": 32,
        "minValid": 32,
        "maxDiscarded": 0,
        "requiredClasses": [
          "owner",
          "non-owner",
          "zero",
          "in-range"
        ],
        "generator": "generator.mjs",
        "predicate": "predicate.mjs",
        "shrinker": "shrinker.mjs"
      },
      {
        "id": "refund-once",
        "method": "sequence",
        "targetRef": "src/state.mjs#run",
        "seed": "42",
        "generator": "generator.mjs",
        "model": "model.mjs",
        "projection": "projection.mjs",
        "maxSteps": 3,
        "minTraces": 3,
        "requiredActions": [
          "Refund",
          "Wait"
        ]
      },
      {
        "id": "ui-boundary",
        "method": "architecture",
        "targetRef": "src/ui.mjs",
        "files": [
          "src/ui.mjs",
          "src/request.mjs"
        ],
        "rules": [
          {
            "id": "no-ui-storage",
            "from": [
              "src/ui.mjs"
            ],
            "forbidden": [
              "node:fs"
            ]
          }
        ]
      },
      {
        "id": "request-path",
        "method": "journey",
        "targetRef": "src/request.mjs#run",
        "entrypoint": "POST /refund",
        "environment": {
          "kind": "local-http-fixture",
          "store": "temporary-file",
          "session": "explicit-owner-fixture"
        },
        "mockBoundaries": [],
        "layers": [
          "http",
          "authorization",
          "database"
        ],
        "layerBindings": [
          {
            "id": "http",
            "adapter": "boundaries/http.mjs",
            "targetRef": "boundaries/http.mjs#request"
          },
          {
            "id": "authorization",
            "adapter": "boundaries/auth.mjs",
            "targetRef": "boundaries/auth.mjs#authorize"
          },
          {
            "id": "database",
            "adapter": "boundaries/store.mjs",
            "targetRef": "boundaries/store.mjs#read"
          }
        ],
        "steps": [
          {
            "id": "denied",
            "action": "request",
            "input": {
              "owner": false,
              "amount": 1,
              "balance": 100
            },
            "expected": {
              "status": "denied"
            },
            "layers": [
              "http",
              "authorization",
              "database"
            ]
          },
          {
            "id": "allowed",
            "action": "request",
            "input": {
              "owner": true,
              "amount": 1,
              "balance": 100
            },
            "expected": {
              "status": "allowed"
            },
            "layers": [
              "http",
              "authorization",
              "database"
            ]
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "authorization",
        "kind": "postcondition",
        "statement": "An unauthorized refund is denied.",
        "checks": [
          "authorization"
        ],
        "requiredFaults": [
          {
            "id": "auth-bypass",
            "kind": "auth-bypass",
            "checkId": "authorization",
            "implementation": "faults/refund.mjs",
            "detects": [
              {
                "kind": "result",
                "id": "denied"
              }
            ]
          }
        ]
      },
      {
        "id": "no-write",
        "kind": "effect",
        "statement": "A denied refund performs no observed store writes.",
        "checks": [
          "no-write"
        ],
        "requiredFaults": [
          {
            "id": "write-undo",
            "kind": "write-undo",
            "checkId": "no-write",
            "implementation": "faults/refund.mjs",
            "detects": [
              {
                "kind": "effect",
                "id": "denied",
                "scope": "store",
                "effectId": "write"
              }
            ]
          }
        ]
      },
      {
        "id": "amount-property",
        "kind": "precondition",
        "statement": "Refund acceptance requires an authorized owner and a positive bounded amount.",
        "checks": [
          "amount-property"
        ],
        "requiredFaults": [
          {
            "id": "always-allow",
            "kind": "always-allow",
            "checkId": "amount-property",
            "implementation": "faults/refund.mjs",
            "detects": [
              {
                "kind": "result",
                "id": "trial-0"
              }
            ]
          }
        ]
      },
      {
        "id": "refund-once",
        "kind": "invariant",
        "statement": "Repeating the refund action never refunds twice.",
        "checks": [
          "refund-once"
        ],
        "requiredFaults": [
          {
            "id": "double-refund",
            "kind": "double-refund",
            "checkId": "refund-once",
            "implementation": "faults/state.mjs",
            "detects": [
              {
                "kind": "result",
                "id": "trace-0:step-1"
              }
            ]
          }
        ]
      },
      {
        "id": "ui-boundary",
        "kind": "architecture",
        "statement": "The UI module does not import filesystem storage.",
        "checks": [
          "ui-boundary"
        ],
        "requiredFaults": [
          {
            "id": "ui-file-access",
            "kind": "ui-file-access",
            "checkId": "ui-boundary",
            "implementation": "faults/ui.mjs",
            "detects": [
              {
                "kind": "rule",
                "id": "no-ui-storage"
              }
            ]
          }
        ]
      },
      {
        "id": "request-path",
        "kind": "journey",
        "statement": "HTTP, authorization and file-store boundaries are observed for each request.",
        "checks": [
          "request-path"
        ],
        "requiredFaults": [
          {
            "id": "wrong-response",
            "kind": "wrong-response",
            "checkId": "request-path",
            "implementation": "faults/request.mjs",
            "detects": [
              {
                "kind": "result",
                "id": "denied"
              }
            ]
          }
        ]
      }
    ]
  }
}
